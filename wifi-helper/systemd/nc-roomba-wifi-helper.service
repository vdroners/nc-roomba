[Unit]
Description=NC Roomba Soft-AP Wi-Fi helper
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/media/4TB/nc-roomba/wifi-helper
EnvironmentFile=-/etc/nc-roomba-wifi-helper.env
Environment=NODE_ENV=production
# Bind on all interfaces so Docker (host.docker.internal) can reach us; lock with TOKEN.
Environment=ROOMBA_WIFI_HELPER_BIND=0.0.0.0
Environment=ROOMBA_WIFI_HELPER_PORT=8091
Environment=ROOMBA_WIFI_IFACE=wlp2s0
ExecStart=/home/vdroners/.nvm/versions/node/v24.18.0/bin/node /media/4TB/nc-roomba/wifi-helper/index.js
Restart=on-failure
RestartSec=3
# Needs nmcli / iw / ip for Soft-AP join.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
