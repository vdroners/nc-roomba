<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>nc_roomba</id>
	<name>NC Roomba</name>
	<summary>Control your Roomba over local MQTT from Nextcloud</summary>
	<description><![CDATA[NC Roomba — start, pause, dock, and monitor a Roomba via a private LAN MQTT bridge. Live mission stage, optional pose map, mission history, schedule editor, error decoder, and Nextcloud Notifications/Activity. No iRobot cloud after onboarding.]]></description>
	<version>0.10.1</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="dan@19labs.com">19labs</author>
	<namespace>NcRoomba</namespace>
	<category>tools</category>
	<website>https://github.com/vdroners/nc-roomba</website>
	<bugs>https://github.com/vdroners/nc-roomba/issues</bugs>
	<repository type="git">https://github.com/vdroners/nc-roomba.git</repository>
	<documentation>https://github.com/vdroners/nc-roomba/blob/main/docs/OPERATOR.md</documentation>
	<dependencies>
		<php min-version="8.1" max-version="8.4"/>
		<database>sqlite</database>
		<database>mysql</database>
		<database>pgsql</database>
		<lib>curl</lib>
		<nextcloud min-version="28" max-version="34"/>
	</dependencies>
	<navigations>
		<navigation>
			<name>NC Roomba</name>
			<route>nc_roomba.page.index</route>
			<icon>app.svg</icon>
			<order>86</order>
		</navigation>
	</navigations>
	<activity>
		<settings>
			<setting>OCA\NcRoomba\Activity\Setting</setting>
		</settings>
		<providers>
			<provider>OCA\NcRoomba\Activity\Provider</provider>
		</providers>
	</activity>
	<commands>
		<command>OCA\NcRoomba\Command\HomeWifi</command>
	</commands>
	<background-jobs>
		<job>OCA\NcRoomba\BackgroundJob\TelemetrySampleJob</job>
		<job>OCA\NcRoomba\BackgroundJob\RetentionPruneJob</job>
	</background-jobs>
	<settings>
		<admin-section>OCA\NcRoomba\Settings\AdminSection</admin-section>
		<admin>OCA\NcRoomba\Settings\AdminSettings</admin>
	</settings>
	<repair-steps>
		<post-migration>
			<step>OCA\NcRoomba\Migration\PurgeEmptyTelemetryRepairStep</step>
		</post-migration>
	</repair-steps>
</info>
