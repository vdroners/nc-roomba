# nc-roomba bridge runtime config (read by docker-compose.bridge.yml)
# Copy to .env and fill in. Never commit .env.

# 1 = mock MQTT (safe for CI / first bring-up). 0 = live robot.
ROOMBA_MOCK=1

# Robot LAN IP (DHCP reservation recommended). Required when ROOMBA_MOCK=0.
ROBOT_IP=

# Local MQTT credentials from hold-HOME get-password (NOT an iRobot cloud login).
BLID=
PASSWORD=

# Optional display name the bridge reports when not yet connected.
ROBOT_NAME=Roomba

# Subnets scanned (TCP :8883) by Auto discover. CIDR list, comma-separated.
ROOMBA_DISCOVER_SUBNETS=192.168.1.0/24

# Optional host Soft-AP wifi-helper (factory provision). Leave empty if unused.
ROOMBA_WIFI_HELPER_URL=http://host.docker.internal:8091
ROOMBA_WIFI_HELPER_TOKEN=

# Image tag for published compose installs (override for pinning).
NC_ROOMBA_BRIDGE_IMAGE=ghcr.io/vdroners/nc-roomba-bridge:latest
